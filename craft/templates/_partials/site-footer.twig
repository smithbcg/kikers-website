{% set phoneHref = 'tel:' ~ siteSettings.phoneNumber|replace({'-': '', ' ': '', '(': '', ')': ''}) %}
{% set managedFooterLogo = siteSettings.footerLogo is defined ? siteSettings.footerLogo.one() : null %}
{% set footerLogoUrl = managedFooterLogo ? managedFooterLogo.url : siteUrl ~ 'assets/logos/kikers-horizontal-white.svg' %}
{% set configuredFooterLinks = siteSettings.footerLinks is defined ? siteSettings.footerLinks : [] %}
{% set retiredFooterUrls = ['/blog', '/tips-guides', '/kikers-home', '/kikers-home-with-photos'] %}
{% set retiredFooterLabels = ['blog', 'tips & guides', 'tips and guides', 'home concept', 'homepage concept', 'home with photos', 'homepage with photos'] %}
{% set footerLinks = [] %}
{% for footerLink in configuredFooterLinks %}
  {% set itemUrl = footerLink.url|default('')|lower|trim|trim('/') %}
  {% set normalizedUrl = itemUrl ? '/' ~ itemUrl : '' %}
  {% set itemLabel = footerLink.label|default('')|lower|trim %}
  {% if normalizedUrl not in retiredFooterUrls and itemLabel not in retiredFooterLabels %}
    {% set footerLinks = footerLinks|merge([footerLink]) %}
  {% endif %}
{% endfor %}
{% set footerGroups = [] %}
{% for footerLink in footerLinks %}
  {% set footerGroup = footerLink.group|default('Links')|trim ?: 'Links' %}
  {% if footerGroup not in footerGroups %}
    {% set footerGroups = footerGroups|merge([footerGroup]) %}
  {% endif %}
{% endfor %}
<footer class="ftr"><div class="wrap">
  <div class="ftr-grid">
    <div class="fcol about">
      <a class="brand brand-logo" href="{{ url('home') }}" aria-label="Kiker's U-Pull-It home"><img class="brand-logo-img" src="{{ footerLogoUrl }}" alt="Kiker's U-Pull-It"></a>
      <p style="margin-top:14px">Self-Service Auto Parts &amp; Cash for Cars</p>
      <p>{{ siteSettings.streetAddress }}</p>
      <p><a class="phone" href="{{ phoneHref }}">{{ siteSettings.phoneNumber }}</a></p>
      <div class="social"><a href="https://www.facebook.com/kikersupullit/" aria-label="Facebook" target="_blank" rel="noopener">f</a></div>
    </div>
    <div class="fcol"><div class="sublinks">
      {% if footerGroups|length %}
        {% for footerGroup in footerGroups %}
          <div><h5>{{ footerGroup }}</h5>
            {% for footerLink in footerLinks %}
              {% set itemGroup = footerLink.group|default('Links')|trim ?: 'Links' %}
              {% if itemGroup == footerGroup and footerLink.label|default('')|trim and footerLink.url|default('')|trim %}
                <a href="{{ footerLink.url }}">{{ footerLink.label }}</a>
              {% endif %}
            {% endfor %}
          </div>
        {% endfor %}
      {% else %}
        <div><h5>Main</h5><a href="{{ url('home') }}">Home</a><a href="{{ url('about') }}">About</a><a href="{{ url('contact') }}">Contact</a><a href="{{ url('privacy') }}">Privacy Policy</a></div>
        <div><h5>Services</h5><a href="{{ url('sell-your-vehicle') }}">Sell Your Vehicle</a><a href="{{ url('we-buy-cars-near-pensacola') }}">We Buy Cars Near Pensacola</a><a href="{{ url('u-pull-parts') }}">Pull Your Own Parts</a><a href="{{ url('full-service-parts') }}">Full-Service Parts</a></div>
        <div><h5>Local Pages</h5><a href="{{ url('sell-your-car-pensacola') }}">Sell Your Car in Pensacola</a><a href="{{ url('sell-your-car-pace') }}">Sell Your Car in Pace</a><a href="{{ url('sell-your-car-milton') }}">Sell Your Car in Milton</a><a href="{{ url('sell-your-car-cantonment') }}">Sell Your Car in Cantonment</a></div>
      {% endif %}
    </div></div>
    <div class="fcol"><h5>Visit Us</h5><p class="mono" style="color:#fff">{{ siteSettings.weekdayHours }}<br>{{ siteSettings.saturdayHours }}<br>Sunday: Closed</p><a class="btn btn--outline-light btn--sm" href="{{ siteSettings.directionsUrl }}" target="_blank" rel="noopener" style="margin-top:14px">Get Directions</a></div>
  </div>
  <div class="ftr-bottom"><span class="copy">&copy; {{ now|date('Y') }} Kiker's U-Pull-It &middot; Pensacola, FL</span><span class="vals">Own it &middot; Do right &middot; Outwork it &middot; Back each other &middot; Watch out</span></div>
</div></footer>
